# AfyaVox AI — Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# ── Whisper (local, no API key needed) ──────────────────────────
# Options: base | small | medium | large
# small = recommended — good for Kikuyu, Luo, Kisii, Swahili, Arabic, Chinese, Korean
# base  = faster but poor accuracy on African/Asian languages
# medium/large = most accurate but very slow on CPU
WHISPER_MODEL=small

# ── Ollama Local LLM (Phase 3) ───────────────────────────────────
# Run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# ── Translation (Phase 2) ────────────────────────────────────────
NLLB_MODEL=facebook/nllb-200-distilled-600M

# ── Server ───────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=104857600

# ── Database (Phase 3+) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/afyavox
REDIS_URL=redis://localhost:6379

# ── Auth (Phase 3+) ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
